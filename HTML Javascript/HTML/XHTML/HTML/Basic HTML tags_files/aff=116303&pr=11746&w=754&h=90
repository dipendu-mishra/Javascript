			oc_banObj += '<embed src="http://banner-a.oddcast.com/ccs2/banners/163.swf" quality="high" bgcolor="#ffffff" width="754" height="90" flashvars="'+oc_flash_vars+'&media=http%3A%2F%2Fbanner-a.oddcast.com%2Fccs2%2Fbanners%2F163%2F" swLiveConnect=true wmode="transparent" name="ODDBANNER" type="application/x-shockwave-flash" pluginspage="http://www.macromedia.com/go/getflashplayer" />';
