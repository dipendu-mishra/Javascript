		}
	}
	else 
	//an image banner (gif/jpg)
	{
		oc_banObj += '<a href="'+oc_bannerLink+'" target="'+(oc_newPage==1?'_blank':'_self')+'"><img src="http://banner-a.oddcast.com/ccs2/banners/163.'+oc_bannerExt+'" width="754" height="90"/></a>';	
	}
	
	
	oc_banObj += '</div>';	
	document.write(oc_banObj);
	
